# --- core ---
INSTANCE_TYPE=api                 # api | worker
CORE_PORT=3100
NODE_ENV=development
# внешний URL API — из него строятся callback_url платёжных вебхуков
PUBLIC_API_URL=http://localhost:3100

# --- data ---
DATABASE_URL=postgres://vpn:vpn@localhost:5442/vpn_platform
REDIS_URL=redis://localhost:6392

# --- tenancy (single-org deploy) ---
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# --- secrets ---
# Ключ шифрования кредов мерчантов (AES-256-GCM). В БД креды лежат только зашифрованными.
# В проде — из vault. Смена ключа делает уже сохранённые креды нечитаемыми.
SECRETS_MASTER_KEY=dev-master-key-change-me

# --- subscription delivery ---
# ДОЛЖЕН совпадать с тем, что уже сохранён у мигрированных клиентов (migration.md P0-2)
SUB_PUBLIC_HOST=panel.gavy.shop
SUB_PROFILE_UPDATE_INTERVAL=12     # часов, заголовок profile-update-interval
SUB_SUPPORT_URL=
SUB_ANNOUNCE=

# --- node-agent ---
# Общий секрет агента (заголовок x-agent-token). Полноценный mTLS — следующий шаг.
AGENT_TOKEN=
# приватный ключ подписи desired-state (RS256), pubkey вшивается в агента
DESIRED_STATE_SIGNING_KEY_REF=vault:vpn-network-2/desired-state-signing

# --- боты (два: клиентский и админский) ---
BOT_TOKEN=
BOT_PORT=3300
# если задан — включается webhook, иначе long polling (для локальной разработки)
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
ADMIN_BOT_TOKEN=
ADMIN_CHAT_ID=
# суммы пополнения баланса в рублях (кнопки в боте)
BOT_TOPUP_AMOUNTS=500,1000,2500,5000
BOT_HAPP_INSTALL_URL=https://happ.su/

# --- core <-> bot ---
BOT_INTERNAL_URL=http://localhost:3300
CORE_API_URL=http://localhost:3100
SERVICE_TOKEN=

# --- платежи ---
# Ключи мерчантов НЕ здесь: они хранятся в БД (таблица payment_merchant)
# и настраиваются через админку без рестарта. Провайдеры: stars, cryptobot,
# oxapay, paritypay, pal24.
PAYMENT_SUCCESS_URL=
PAYMENT_FAIL_URL=
