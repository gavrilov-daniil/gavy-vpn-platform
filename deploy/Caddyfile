# Директивы email здесь намеренно нет: с пустой переменной Caddy падает на старте
# («wrong argument count after 'email'»), а падение Caddy = недоступны разом выдача
# подписки, вебхуки платежей и админка. ACME выпускает сертификаты и без адреса;
# он нужен только для писем об истечении, а за этим следит мониторинг.

# Пережидание рестарта core. Релиз пересоздаёт контейнер, и без этого клиент в те
# 3-5 секунд получает 502: подписка не выдаётся, вебхук провайдера отвергается.
# Caddy повторяет попытку, пока новый контейнер поднимается, — блип наружу не виден.
# Повтор делается только там, где до апстрима ничего не ушло (отказ соединения),
# так что повторной обработки уже принятого вебхука это не создаёт.
(core_upstream) {
	reverse_proxy core:3100 {
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}

# --- Публичный домен подписки ---
# Домен и пути обязаны совпадать с тем, что уже сохранено у клиентов:
# /auto/<shortUuid> и legacy /api/sub/<id>. Смена любого из них = молчаливый
# отвал мигрированной базы (docs/migration.md, P0-2).
{$SUB_DOMAIN} {
	encode gzip

	# Выдача подписки и вебхуки платёжных провайдеров
	@public path /auto/* /api/sub/* /webhooks/* /healthz
	handle @public {
		import core_upstream
	}

	# Вебхук Telegram-бота: секрет проверяет сам бот заголовком
	handle /tg {
		reverse_proxy bot:3300 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	# Вход агентов нод. Именно здесь, а не на админском домене: ноды стоят у разных
	# хостеров и должны достучаться до control-plane по публичному адресу, а админку
	# разумно закрывать по IP. Защита — персональный токен ноды (x-agent-token),
	# проверяется в самом контроллере. Остальной /internal/* наружу НЕ выставляем:
	# там служебные ручки бота и воркеров.
	handle /internal/agent/* {
		import core_upstream
	}

	# Всё остальное на этом домене наружу не смотрит: админский и служебный API
	# доступны только на своём домене.
	handle {
		respond "not found" 404
	}
}

# --- Домен админки ---
# Отдельный домен, чтобы админский API не висел там же, где публичная выдача:
# случайно открытый путь на домене подписки — это дамп базы подписчиков.
{$ADMIN_DOMAIN} {
	encode gzip

	handle /api/* {
		import core_upstream
	}

	# SPA: любой маршрут отдаёт index.html, роутинг внутри React.
	# current — каталог, который admin-build подменяет переименованием целиком,
	# поэтому состояния «половина файлов новые» не бывает.
	handle {
		root * /srv/admin/current
		try_files {path} /index.html
		file_server
	}
}
