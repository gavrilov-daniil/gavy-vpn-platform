{
  "name": "@vpn/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "seed": "tsx src/seed.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@vpn/core-kit": "workspace:*",
    "@vpn/db": "workspace:*",
    "@vpn/payments": "workspace:*",
    "@vpn/xray-config": "workspace:*",
    "bullmq": "^5.81.2",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  }
}
